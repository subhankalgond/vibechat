# Server
PORT=5000
NODE_ENV=development

# Supabase Postgres connection string.
# Supabase dashboard > Project Settings > Database > Connection string > URI.
# Replace [YOUR-PASSWORD] with the database password you set when creating
# the project. Use the "Connection pooling" string on Render/Railway.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Auth. Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Client origin allowed by CORS (comma separated for multiple)
CLIENT_URL=http://localhost:5173

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Max media upload size in MB
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
